import frappe

from chromeis_sync.migration_audit.models import VerificationResult


class GLVerifier:

    def verify(self, snapshot, new_invoice):

        result = VerificationResult()

        old_gl = [
            row
            for row in snapshot["gl_entries"]
            if round(float(row["debit"]), 2) != 0
            or round(float(row["credit"]), 2) != 0
        ]

        old_gl = sorted(
            old_gl,
            key=lambda x: (x["account"], x["debit"], x["credit"])
        )

        new_gl = frappe.db.sql("""
            SELECT
                account,
                debit,
                credit
            FROM `tabGL Entry`
            WHERE voucher_no=%s
            ORDER BY account
        """, new_invoice.name, as_dict=True)

        new_gl = [
            row
            for row in new_gl
            if round(float(row["debit"]), 2) != 0
            or round(float(row["credit"]), 2) != 0
        ]

        new_gl = [
            row
            for row in new_gl
            if row["account"] != "Round Off - CPL"
        ]

        new_gl = sorted(
            new_gl,
            key=lambda x: (x["account"], x["debit"], x["credit"])
        )

        # ----------------------------------------------------
        # Tax-aware validation
        # ----------------------------------------------------

        tax_amount = round(
            float(new_invoice.total_taxes_and_charges or 0),
            2,
        )

        if tax_amount > 0:

            old_accounts = {
                row["account"]: row
                for row in old_gl
            }

            new_accounts = {
                row["account"]: row
                for row in new_gl
            }

            # Every historical account except Debtors
            # must still exist.

            for account in old_accounts:

                if account == "Debtors - CPL":
                    continue

                if account not in new_accounts:
                    result.passed = False
                    result.errors.append(
                        f"Missing GL account: {account}"
                    )

            if "Debtors - CPL" not in new_accounts:
                result.passed = False
                result.errors.append(
                    "Missing Debtors GL"
                )

            if "GST - CPL" not in new_accounts:
                result.passed = False
                result.errors.append(
                    "Missing GST GL"
                )

            return result

        # ----------------------------------------------------
        # Legacy (No Tax)
        # ----------------------------------------------------

        if len(old_gl) != len(new_gl):

            result.passed = False

            result.errors.append(
                f"GL row count mismatch "
                f"(old={len(old_gl)}, new={len(new_gl)})"
            )

            result.errors.append("---- OLD GL ----")
            for row in old_gl:
                result.errors.append(
                    f"{row['account']} | D={row['debit']} | C={row['credit']}"
                )

            result.errors.append("---- NEW GL ----")
            for row in new_gl:
                result.errors.append(
                    f"{row['account']} | D={row['debit']} | C={row['credit']}"
                )

            return result

        for index, (old_row, new_row) in enumerate(
            zip(old_gl, new_gl),
            start=1,
        ):

            if old_row["account"] != new_row["account"]:

                result.passed = False

                result.errors.append(
                    f"GL Row {index}: account mismatch "
                    f"({old_row['account']} != {new_row['account']})"
                )

        return result
