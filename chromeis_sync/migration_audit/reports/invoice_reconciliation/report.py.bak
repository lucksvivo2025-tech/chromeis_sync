"""
Invoice Reconciliation Report

R002
"""

import frappe

from chromeis_sync.migration_audit.reports.core.base_report import BaseReport


class InvoiceReconciliationReport(BaseReport):

    report_id = "R002"
    report_name = "Invoice Reconciliation"

    def execute(self):

        print("\n====================================================")
        print("INVOICE RECONCILIATION")
        print("====================================================\n")

        # ---------------------------------------------------------
        # WHMCS Summary
        # ---------------------------------------------------------

        self.summary("WHMCS Total Invoices",
                     "SELECT COUNT(*) FROM whmcs_mirror.tblinvoices")

        self.summary("WHMCS Paid",
                     "SELECT COUNT(*) FROM whmcs_mirror.tblinvoices WHERE status='Paid'")

        self.summary("WHMCS Paid (>0)",
                     """
                     SELECT COUNT(*)
                     FROM whmcs_mirror.tblinvoices
                     WHERE status='Paid'
                     AND total > 0
                     """)

        self.summary("WHMCS Cancelled",
                     "SELECT COUNT(*) FROM whmcs_mirror.tblinvoices WHERE status='Cancelled'")

        self.summary("WHMCS Unpaid",
                     "SELECT COUNT(*) FROM whmcs_mirror.tblinvoices WHERE status='Unpaid'")

        self.summary("WHMCS Collections",
                     "SELECT COUNT(*) FROM whmcs_mirror.tblinvoices WHERE status='Collections'")

        self.summary("WHMCS Refunded",
                     "SELECT COUNT(*) FROM whmcs_mirror.tblinvoices WHERE status='Refunded'")

        self.summary("WHMCS Draft",
                     "SELECT COUNT(*) FROM whmcs_mirror.tblinvoices WHERE status='Draft'")

        print()

        # ---------------------------------------------------------
        # ERP Summary
        # ---------------------------------------------------------

        self.summary("ERP Draft",
                     """
                     SELECT COUNT(*)
                     FROM `tabSales Invoice`
                     WHERE docstatus=0
                     """)

        self.summary("ERP Submitted",
                     """
                     SELECT COUNT(*)
                     FROM `tabSales Invoice`
                     WHERE docstatus=1
                     """)

        self.summary("ERP Cancelled",
                     """
                     SELECT COUNT(*)
                     FROM `tabSales Invoice`
                     WHERE docstatus=2
                     """)

        self.summary("ERP Total",
                     "SELECT COUNT(*) FROM `tabSales Invoice`")

        print()

        # ---------------------------------------------------------
        # Migration Metrics
        # ---------------------------------------------------------

        self.summary("Invoices with WHMCS ID",
                     """
                     SELECT COUNT(*)
                     FROM `tabSales Invoice`
                     WHERE whmcs_invoice_id IS NOT NULL
                     AND whmcs_invoice_id != ''
                     """)

        self.summary("Invoices with Client Mapping",
                     """
                     SELECT COUNT(*)
                     FROM `tabSales Invoice`
                     WHERE custom_whmcs_client_id IS NOT NULL
                     AND custom_whmcs_client_id != ''
                     """)

        print("\nReport Complete.\n")

    def summary(self, metric, sql):

        value = frappe.db.sql(sql)[0][0]

        self.add_result(
            metric=metric,
            whmcs=value,
            erp=None,
            status="INFO"
        )

        print(f"{metric:<35} {value}")


def execute():

    report = InvoiceReconciliationReport()

    report.start()

    report.execute()

    report.finish()

    return report.results
